# ─── Bot Identity ─────────────────────────────────────────────────────────────
BOT_NAME=HarunaBot
PREFIX=!

# ─── Owner ────────────────────────────────────────────────────────────────────
OWNER_NUMBER=628xxxxxx

# ─── Login Mode ───────────────────────────────────────────────────────────────
PAIRING_NUMBER=628xxxxxx

# ─── Paths ────────────────────────────────────────────────────────────────────
SESSION_PATH=./sessions
DB_PATH=./data/akanebot.db

# ─── Auth Backend ─────────────────────────────────────────────────────────────
# file   = development (default)
# sqlite = production (lebih efisien)
AUTH_BACKEND=file
SESSION_ID=default

# ─── AI Provider (isi salah satu) ─────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5

# GROQ_API_KEY=gsk_...          ← Gratis, daftar di console.groq.com
# GROQ_MODEL=llama-3.1-8b-instant

# ─── AI Agent (Gemini — natural language + tool calling) ──────────────────────
# true  = aktifkan agent (user bisa chat bebas, bot paham intent & jalankan tools)
# false = perilaku lama (mention-AI chat / command saja)
# Key Gemini: https://aistudio.google.com/apikey
AI_AGENT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AGENT_MAX_TOOL_CALLS=5        # batas tool calls per permintaan (anti infinite loop)
AGENT_RATE_LIMIT_MAX=10       # max panggilan agent per user per window
AGENT_RATE_LIMIT_WINDOW=60    # detik
AGENT_COOLDOWN_MS=5000        # jeda minimal antar panggilan per user
AGENT_TIMEOUT_MS=30000        # timeout request ke API Gemini
AGENT_MAX_HISTORY=6           # jumlah pesan konteks yang diingat per user

# ─── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Terminal UI ───────────────────────────────────────────────────────────
# true  = alternate-screen TUI dashboard (blessed)
# false = standard console banner (default)
DASH_TERMINAL=false

# ─── Misc ─────────────────────────────────────────────────────────────────────
TIMEZONE=Asia/Jakarta
RESPOND_TO_SELF=false
NODE_ENV=development
